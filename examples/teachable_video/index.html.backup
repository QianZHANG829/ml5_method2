<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Teachable Video</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>
  <main class="container">

    <!-- ===== Classes Column ===== -->
    <section class="column classes">
      <!-- Class 1 card -->
      <div class="card">
        <header class="card-header">
          <span>Class 1</span>
          <button class="icon-btn edit-btn" title="Edit Class">
            ✎
          </button>
        </header>
        <div class="card-body">
          <label class="label-title">Add Video Samples:</label>
          <div class="btn-group">
            <button class="action-btn">
              🎥<br><span>Webcam</span>
            </button>
            <button class="action-btn">
              ⬆️<br><span>Upload</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Class 2 card -->
      <div class="card">
        <header class="card-header">
          <span>Class 2</span>
          <button class="icon-btn edit-btn" title="Edit Class">
            ✎
          </button>
        </header>
        <div class="card-body">
          <label class="label-title">Add Video Samples:</label>
          <div class="btn-group">
            <button class="action-btn">
              🎥<br><span>Webcam</span>
            </button>
            <button class="action-btn">
              ⬆️<br><span>Upload</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Add Class placeholder -->
      <button class="card add-card">
        + Add a class
      </button>
    </section>


    <!-- ===== Training Column ===== -->
    <section class="column training">
      <div class="card">
        <header class="card-header">
          <span>Training</span>
        </header>
        <div class="card-body">
          <button class="full-btn">Train Model</button>
          <details class="advanced">
            <summary>Advanced</summary>
            <!-- optional advanced settings here -->
          </details>
        </div>
      </div>
    </section>


    <!-- ===== Preview Column ===== -->
    <section class="column preview">
      <div class="card">
        <header class="card-header">
          <span>Preview</span>
          <button class="icon-btn export-btn" title="Export Model">
            ⬆️
          </button>
        </header>
        <div class="card-body">
          <p class="help-text">
            You must train a model on the left before you can preview it here.
          </p>
        </div>
      </div>
    </section>

  </main>
</body>
</html>
